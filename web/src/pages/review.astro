---
import FehlerbuchReview from '../components/FehlerbuchReview.svelte';
import AppShell from '../layouts/AppShell.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<AppShell title="Fehlerbuch — Deutsch lernen" navKey="review" variant="app">
  <header class="page-head">
    <h1>Fehlerbuch</h1>
    <p class="lead">
      Wörter und Antworten, die du zuletzt falsch hattest — automatisch gesammelt
      aus deinen Übungen.
    </p>
  </header>

  <FehlerbuchReview client:load />
</AppShell>
