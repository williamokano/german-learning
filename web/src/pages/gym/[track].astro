---
import { getCollection } from 'astro:content';
import { GrammarTrack } from '@core/content/schema';
import { trackBank } from '@core/content/drills';
import DrillRunner from '../../components/DrillRunner.svelte';
import AppShell from '../../layouts/AppShell.astro';

export async function getStaticPaths() {
  return GrammarTrack.options.map(track => ({ params: { track } }));
}

const { track } = Astro.params;
const all = await getCollection('exercises');
const items = trackBank(all, track as (typeof GrammarTrack.options)[number]);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<AppShell title={`${track} — Grammatik-Gym`} navKey="gym" variant="app" crumbs={[{ label: 'Grammatik-Gym', href: `${base}/gym/` }, { label: track }]}>
  <header class="page-head">
    <h1>{track}</h1>
  </header>

  <DrillRunner items={items} sessionSize={10} client:load />
</AppShell>
