---
import { getCollection } from 'astro:content';
import { GrammarTrack } from '@core/content/schema';
import { trackCounts } from '@core/content/drills';
import AppShell from '../../layouts/AppShell.astro';

const all = await getCollection('exercises');
const counts = trackCounts(all);

const LABELS: Record<string, string> = {
  'adjektivdeklination': 'Adjektivdeklination (der-/ein-/Nullartikel)',
  'akkusativ': 'Akkusativ',
  'dativ': 'Dativ',
  'praepositionen': 'Präpositionen (Wechsel- & feste Präpositionen)',
  'vergangenheit': 'Vergangenheit (Perfekt & Präteritum)',
};

const tracks = GrammarTrack.options.map(track => ({ track, label: LABELS[track] ?? track, count: counts[track] }));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<AppShell title="Grammatik-Gym — Deutsch lernen" navKey="gym" variant="app" crumbs={[{ label: 'Grammatik-Gym' }]}>
  <header class="page-head">
    <h1>Grammatik-Gym</h1>
    <p class="lead">
      Wähle eine Grammatik-Strecke, um gezielt zu üben — Übungen aus dem ganzen Kurs.
    </p>
  </header>

  <ul class="link-list">
    {tracks.map(t => (
      <li class:list={{ empty: t.count === 0 }}>
        <a href={t.count > 0 ? `${base}/gym/${t.track}/` : undefined}>
          <span>{t.label}</span>
          <span class="count">{t.count} Übungen</span>
        </a>
      </li>
    ))}
  </ul>
</AppShell>
