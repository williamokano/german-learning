---
import { getCollection, render } from 'astro:content';
import { coreDedupKeysUpTo } from '@core/content/vocab';
import LessonLayout from '../../../layouts/LessonLayout.astro';

export async function getStaticPaths() {
  const [allLessons, allShort, allExercises, allVocab] = await Promise.all([
    getCollection('lessons'),
    getCollection('lessons-short'),
    getCollection('exercises'),
    getCollection('vocab'),
  ]);
  const vocabSets = allVocab.map(e => e.data);

  return allLessons.map(entry => {
    const parts = entry.id.split('/');
    const level = parts[0] ?? 'a1';
    const slug = parts[1] ?? entry.id;
    const lessonKey = `${level}/${slug}`;
    const shortId = `${level}/${slug}/lesson-short`;
    const shortEntry = allShort.find(e => e.id === shortId) ?? null;
    const lessonId = `${level.toUpperCase()}/${slug.split('-')[0]}`;
    return {
      params: { level, lesson: slug },
      props: {
        entry,
        hasExercises: allExercises.some(e => e.id.startsWith(lessonKey + '/')),
        hasShort: shortEntry !== null,
        shortEntry,
        wortschatzDedupKeys: coreDedupKeysUpTo(vocabSets, lessonId),
      },
    };
  });
}

const { entry, hasExercises, hasShort, shortEntry, wortschatzDedupKeys } = Astro.props;
const { level, lesson } = Astro.params;

const title =
  entry.data.title ??
  lesson.replace(/^\d+-/, '').replace(/-/g, ' ')
        .replace(/\b\w/g, c => c.toUpperCase());

const { Content } = await render(entry);
const { Content: ShortContent } = shortEntry
  ? await render(shortEntry)
  : { Content: null };

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<LessonLayout
  {title}
  {level}
  {hasShort}
  {wortschatzDedupKeys}
  shortTitle={`${title} — Kurzfassung`}
>
  <section data-view="full">
    <Content />
  </section>

  {hasShort && ShortContent && (
    <section data-view="short" hidden>
      <ShortContent />
    </section>
  )}

  {hasExercises && (
    <nav class="exercises-cta">
      <a href={`${base}/${level}/${lesson}/uebungen/`} class="btn-uebungen">
        Übungen →
      </a>
    </nav>
  )}
</LessonLayout>

<style>
  .exercises-cta { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb; }
  .btn-uebungen {
    display: inline-block;
    padding: 0.55rem 1.4rem;
    background: #2563eb;
    color: #fff;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.12s;
  }
  .btn-uebungen:hover { background: #1d4ed8; }
</style>
