---
import { getCollection } from 'astro:content';
import { coreDedupKeysUpTo } from '@core/content/vocab';
import AppShell from '../../../layouts/AppShell.astro';
import WortschatzCounter from '../../../components/WortschatzCounter.svelte';
import BlockRunner from '../../../components/BlockRunner.svelte';
import ExamSimulator from '../../../components/ExamSimulator.svelte';

export async function getStaticPaths() {
  const [all, allVocab] = await Promise.all([
    getCollection('exercises'),
    getCollection('vocab'),
  ]);
  const vocabSets = allVocab.map(e => e.data);

  return all.map(entry => {
    const parts = entry.id.split('/');
    return {
      params: { level: parts[0], lesson: parts[1] },
      props: { entry, wortschatzDedupKeys: coreDedupKeysUpTo(vocabSets, entry.data.lesson) },
    };
  });
}

const { level, lesson } = Astro.params;
const { entry, wortschatzDedupKeys } = Astro.props;
const data = entry.data;

// Build the audio directory path matching web/public/audio/<LEVEL>/<slug>/
const audioDir = `audio/${level.toUpperCase()}/${lesson}/`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Standalone sets (THEMEN/, SITUATIONEN/) have no lesson page above them, so
// their breadcrumb goes straight back to their own index instead of a level.
const STANDALONE: Record<string, { label: string; href: string }> = {
  themen:      { label: 'Grammatikthemen',    href: 'themen' },
  situationen: { label: 'Alltagssituationen', href: 'situationen' },
  hoeren:      { label: 'Hörverstehen',       href: 'hoeren' },
};
const standalone = STANDALONE[level];
const displayLevel = (data.level ?? level).toUpperCase();

const BLOCK_NAMES: Record<string, string> = {
  H: 'Hören',
  A: 'Basistraining',
  B: 'Vertiefung',
  C: 'Prüfungstraining',
  D: 'Wiederholung',
  exam: 'Prüfung',
};
const blocks = ['H', 'A', 'B', 'C', 'D', 'exam']
  .map(b => ({
    key: b === 'exam' ? 'P' : b,
    name: BLOCK_NAMES[b],
    count: data.exercises.filter(ex => ex.block === b).length,
  }))
  .filter(b => b.count > 0);

const crumbs = standalone
  ? [{ label: standalone.label, href: `${base}/${standalone.href}/` }, { label: data.title }]
  : [
      { label: displayLevel, href: `${base}/${level}/` },
      { label: data.title, href: `${base}/${level}/${lesson}/` },
      { label: 'Übungen' },
    ];
---

<AppShell
  title={`${data.title} · Übungen`}
  navKey={level}
  variant="app"
  crumbs={crumbs}
>
  <div slot="topbar-extra">
    <WortschatzCounter dedupKeys={wortschatzDedupKeys} client:load />
  </div>

  <div class="ex-layout">
    <div class="ex-main">
      <header class="ex-head card" data-level={displayLevel.toLowerCase()}>
        <div class="ex-head-top">
          <span class="badge badge-level">{displayLevel}</span>
          {data.topic && <span class="badge badge-soft">{data.topic}</span>}
        </div>
        <h1>{data.title}</h1>
        {data.intro && <p class="ex-intro">{data.intro}</p>}
        {!standalone && (
          <a class="ex-back" href={`${base}/${level}/${lesson}/`}>← Zur Lektion</a>
        )}
      </header>

      {data.exam
        ? <ExamSimulator
            exercises={data.exercises}
            lessonId={data.lesson}
            audioDir={audioDir}
            examGrid={data.exam}
            lessonUrl={`${base}/${level}/${lesson}/`}
            level={displayLevel}
            client:load
          />
        : <BlockRunner
            exercises={data.exercises}
            lessonId={data.lesson}
            audioDir={audioDir}
            level={displayLevel}
            client:load
          />
      }
    </div>

    <aside class="ex-aside">
      <div class="aside-card card" data-level={displayLevel.toLowerCase()}>
        <h2 class="aside-title">Dieses Set</h2>
        <ul class="block-list">
          {blocks.map(b => (
            <li>
              <span class="block-key">{b.key}</span>
              <span class="block-name">{b.name}</span>
              <span class="block-count">{b.count}</span>
            </li>
          ))}
        </ul>
        <p class="aside-total">{data.exercises.length} Übungen insgesamt</p>
      </div>

      <div class="aside-card card aside-tip">
        <h2 class="aside-title">So funktioniert's</h2>
        <p>
          Fülle die Lücken aus und klicke auf <strong>Auswerten</strong>.
          Du bekommst sofort pro Aufgabe eine Rückmeldung und am Ende eine
          Prozentzahl.
        </p>
      </div>
    </aside>
  </div>
</AppShell>

<style>
  .ex-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: var(--space-6);
    align-items: start;
  }
  .ex-main { min-width: 0; }

  .ex-head {
    padding: var(--space-5) var(--space-6);
    margin-bottom: var(--space-5);
    border-left: 4px solid var(--level-color, var(--brand-600));
  }
  .ex-head-top {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .ex-head h1 { margin: 0; font-size: var(--text-2xl); letter-spacing: -0.02em; }
  .ex-intro {
    margin: var(--space-3) 0 0;
    color: var(--text-muted);
    font-size: var(--text-base);
    max-width: 68ch;
  }
  .ex-back {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: var(--text-base);
    color: var(--text-muted);
  }
  .ex-back:hover { color: var(--brand-600); }

  .ex-aside {
    position: sticky;
    top: calc(var(--topbar-h) + var(--space-6));
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .aside-card { padding: var(--space-4) var(--space-5); }
  .aside-title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .block-list { list-style: none; margin: 0; padding: 0; }
  .block-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    font-size: var(--text-base);
  }
  .block-list li + li { border-top: 1px solid var(--border); }
  .block-key {
    display: grid;
    place-items: center;
    width: 1.6rem; height: 1.6rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--level-color, var(--brand-600)) 15%, transparent);
    color: var(--level-color, var(--brand-600));
    font-weight: 800;
    font-size: var(--text-xs);
    flex-shrink: 0;
  }
  .block-name { color: var(--text-muted); }
  .block-count {
    margin-left: auto;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
  }
  .aside-total {
    margin: var(--space-3) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--text-subtle);
  }
  .aside-tip p { margin: 0; font-size: var(--text-base); color: var(--text-muted); }

  @media (max-width: 1100px) {
    .ex-layout { grid-template-columns: minmax(0, 1fr); }
    .ex-aside { position: static; flex-direction: row; flex-wrap: wrap; }
    .aside-card { flex: 1 1 16rem; }
  }
</style>
