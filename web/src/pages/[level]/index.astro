---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('lessons');
  const vocab = await getCollection('vocab');
  const levels = [...new Set(all.map(e => e.id.split('/')[0]))];
  return levels.map(level => ({
    params: { level },
    props:  {
      lessons: all.filter(e => e.id.startsWith(level + '/')),
      // entry.id is "<level>/<slug>/vocab" — keep only the level/slug prefix so it
      // matches the level/slug pairs this page renders links for.
      vocabIds: new Set(vocab.map(e => e.id.split('/').slice(0, 2).join('/'))),
    },
  }));
}

const { level }   = Astro.params;
const { lessons, vocabIds } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const sorted = lessons
  .map(e => ({ entry: e, slug: e.id.split('/')[1] }))
  .sort((a, b) => a.slug.localeCompare(b.slug));
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{level} — Deutsch lernen</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 3rem auto; padding: 0 1rem; }
      nav a { color: #2563eb; text-decoration: none; font-size: 0.875rem; }
      ul { list-style: none; padding: 0; margin-top: 1.5rem; }
      li { display: flex; align-items: center; }
      li a { display: block; padding: 0.5rem 0.75rem; border-radius: 6px; color: #1a1a1a; text-decoration: none; }
      li a:hover { background: #eff6ff; }

      .btn-uebungen { margin-left: auto; flex-shrink: 0; padding: 0.25rem 0.6rem; border: 1.5px solid #2563eb; border-radius: 6px; color: #2563eb; text-decoration: none; font-size: 0.8rem; white-space: nowrap; }
      .btn-uebungen:hover { background: #eff6ff; }
      .btn-flashcards { flex-shrink: 0; padding: 0.25rem 0.6rem; border: 1.5px solid #6b7280; border-radius: 6px; color: #6b7280; text-decoration: none; font-size: 0.8rem; white-space: nowrap; }
      .btn-flashcards:hover { background: #f3f4f6; }
    </style>
  </head>
  <body>
    <nav><a href={`${base}/`}>← Startseite</a></nav>
    <h1>{level.toUpperCase()}</h1>
    <ul>
      {sorted.map(({ slug }) => (
        <li>
          <a href={`${base}/${level}/${slug}/`}>
            {(([num, ...rest]) => `${num} — ${rest.join('-').replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())}`)(slug.split('-'))}
          </a>
          {vocabIds.has(`${level}/${slug}`) && (
            <a class="btn-flashcards" href={`${base}/flashcards/${level}/${slug}/`}>Karteikarten</a>
          )}
          <a class="btn-uebungen" href={`${base}/${level}/${slug}/uebungen/`}>Übungen →</a>
        </li>
      ))}
    </ul>
  </body>
</html>
