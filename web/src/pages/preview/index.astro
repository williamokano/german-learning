---
/**
 * PROTOTYPE INDEX — entry point for validating the redesign.
 * Not linked from the live site; reachable at /preview/.
 */
import AppShell from '../../layouts/AppShell.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pages = [
  {
    href: `${base}/preview/dashboard/`,
    title: 'Übersicht (Startseite)',
    desc: 'Hero, Kennzahlen, Kurs-Kacheln, Übungs-Shortcuts.',
    shows: ['Top-Bar + Sidebar', 'Volle Seitenbreite', 'Karten-Raster'],
  },
  {
    href: `${base}/preview/uebungen/`,
    title: 'Übungsseite',
    desc: 'Echtes Übungsset (Personalpronomen A1) mit Auswertung und Note.',
    shows: ['Neue Eingabefelder', 'Zweispaltiges Layout', 'Bewertungssystem unverändert'],
  },
  {
    href: `${base}/preview/lektion/`,
    title: 'Lektionsseite',
    desc: 'Lesefassung mit schmalerer Textspalte und Inhaltsverzeichnis.',
    shows: ['Prose-Breite', 'Sticky-Inhaltsverzeichnis', 'Merkkästen'],
  },
];

const changes = [
  ['Kopfzeile', 'Sticky Top-Bar mit Wortmarke, Brotkrumen und Farbschema-Umschalter.'],
  ['Seitenleiste', 'Gruppierte Navigation (Lernen · Kurs · Üben · Wortschatz), einklappbar, auf Mobil als Drawer.'],
  ['Breite', 'Inhalt nutzt die volle Seitenbreite (bis 78rem) statt fixer 52rem; Lesetexte bleiben schmaler.'],
  ['Eingabefelder', 'Feste Höhe (1,8em) mit ausreichender Zeilenhöhe — sie berühren sich nicht mehr.'],
  ['Farben', 'Design-Tokens für Licht und Dunkel; Niveaus (A1–C1) haben eigene Akzentfarben.'],
  ['Übungssystem', 'Unverändert — dieselben Widgets, dieselbe Auswertung, dieselben Inhalte.'],
];
---

<AppShell title="Design-Vorschau" navKey="" variant="app">
  <header class="ph">
    <span class="badge badge-soft">Prototyp</span>
    <h1>Design-Vorschau</h1>
    <p>
      Drei Beispielseiten im neuen Layout. Inhalte und Übungslogik sind
      unverändert — nur die Oberfläche ist neu. Wenn das so passt, rolle ich
      es auf alle Seiten aus.
    </p>
  </header>

  <section class="grid">
    {pages.map(p => (
      <a class="pcard card" href={p.href}>
        <h2>{p.title}</h2>
        <p>{p.desc}</p>
        <ul>
          {p.shows.map(s => <li>{s}</li>)}
        </ul>
        <span class="pcard-go">Ansehen →</span>
      </a>
    ))}
  </section>

  <section class="changes card">
    <h2>Was sich ändert</h2>
    <dl>
      {changes.map(([term, desc]) => (
        <div class="change-row">
          <dt>{term}</dt>
          <dd>{desc}</dd>
        </div>
      ))}
    </dl>
  </section>

  <p class="back">
    <a href={`${base}/`}>← Zur aktuellen Startseite (altes Design)</a>
  </p>
</AppShell>

<style>
  .ph { margin-bottom: var(--space-6); max-width: 60ch; }
  .ph h1 { margin: var(--space-3) 0 var(--space-3); font-size: var(--text-3xl); letter-spacing: -0.02em; }
  .ph p { margin: 0; color: var(--text-muted); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .pcard {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    color: inherit;
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .pcard:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: var(--brand-300);
    text-decoration: none;
  }
  .pcard h2 { margin: 0 0 var(--space-2); font-size: var(--text-lg); }
  .pcard > p { margin: 0 0 var(--space-3); color: var(--text-muted); font-size: var(--text-base); }
  .pcard ul {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .pcard li {
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--surface-3);
    color: var(--text-subtle);
  }
  .pcard-go { margin-top: auto; font-weight: 650; color: var(--brand-600); font-size: var(--text-base); }

  .changes { padding: var(--space-5) var(--space-6); margin-bottom: var(--space-5); }
  .changes h2 { margin: 0 0 var(--space-4); font-size: var(--text-lg); }
  .changes dl { margin: 0; }
  .change-row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-3) 0;
  }
  .change-row + .change-row { border-top: 1px solid var(--border); }
  .change-row dt { font-weight: 650; }
  .change-row dd { margin: 0; color: var(--text-muted); }

  .back { font-size: var(--text-base); }

  @media (max-width: 700px) {
    .change-row { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); }
  }
</style>
