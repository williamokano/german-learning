---
/**
 * PROTOTYPE — redesigned exercise page, rendered with a real exercise set
 * so the widgets, grading and scoring can be tested for real.
 */
import { getCollection } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';
import BlockRunner from '../../components/BlockRunner.svelte';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const exercises = await getCollection('exercises');
const entry = exercises.find(e => e.id.startsWith('extra/01-personalpronomen-a1'))!;
const data = entry.data;

const BLOCK_NAMES: Record<string, string> = {
  H: 'Hören',
  A: 'Basistraining',
  B: 'Vertiefung',
  C: 'Prüfungstraining',
  D: 'Wiederholung',
};
const blockOrder = ['H', 'A', 'B', 'C', 'D'];
const blocks = blockOrder
  .map(b => ({
    key: b,
    name: BLOCK_NAMES[b],
    count: data.exercises.filter(ex => ex.block === b).length,
  }))
  .filter(b => b.count > 0);

const level = (data.level ?? 'A1').toLowerCase();
const totalExercises = data.exercises.length;
---

<AppShell
  title={`${data.title} · Übungen`}
  navKey="extra"
  variant="app"
  crumbs={[
    { label: 'Zusatzübungen', href: `${base}/extra/` },
    { label: data.title },
  ]}
>
  <div class="ex-layout">
    <div class="ex-main">
      <header class="ex-head card" data-level={level}>
        <div class="ex-head-top">
          <span class="badge badge-level">{(data.level ?? 'A1').toUpperCase()}</span>
          {data.topic && <span class="badge badge-soft">{data.topic}</span>}
        </div>
        <h1>{data.title}</h1>
        {data.intro && <p class="ex-intro">{data.intro}</p>}
      </header>

      <BlockRunner
        exercises={data.exercises}
        lessonId={data.lesson}
        audioDir=""
        client:load
      />
    </div>

    <aside class="ex-aside">
      <div class="aside-card card">
        <h2 class="aside-title">Dieses Set</h2>
        <ul class="block-list">
          {blocks.map(b => (
            <li>
              <span class="block-key" data-level={level}>{b.key}</span>
              <span class="block-name">{b.name}</span>
              <span class="block-count">{b.count}</span>
            </li>
          ))}
        </ul>
        <p class="aside-total">{totalExercises} Übungen insgesamt</p>
      </div>

      <div class="aside-card card aside-tip">
        <h2 class="aside-title">So funktioniert's</h2>
        <p>
          Fülle die Lücken aus und klicke auf <strong>Auswerten</strong>.
          Du bekommst sofort pro Aufgabe eine Rückmeldung und am Ende eine
          Prozentzahl.
        </p>
      </div>
    </aside>
  </div>
</AppShell>

<style>
  .ex-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: var(--space-6);
    align-items: start;
  }
  .ex-main { min-width: 0; }

  .ex-head {
    padding: var(--space-5) var(--space-6);
    margin-bottom: var(--space-5);
    border-left: 4px solid var(--level-color, var(--brand-600));
  }
  .ex-head-top {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .ex-head h1 {
    margin: 0;
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }
  .ex-intro {
    margin: var(--space-3) 0 0;
    color: var(--text-muted);
    font-size: var(--text-base);
    max-width: 68ch;
  }

  /* ---- aside ---- */
  .ex-aside {
    position: sticky;
    top: calc(var(--topbar-h) + var(--space-6));
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .aside-card { padding: var(--space-4) var(--space-5); }
  .aside-title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .block-list { list-style: none; margin: 0; padding: 0; }
  .block-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    font-size: var(--text-base);
  }
  .block-list li + li { border-top: 1px solid var(--border); }
  .block-key {
    display: grid;
    place-items: center;
    width: 1.6rem; height: 1.6rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--level-color, var(--brand-600)) 15%, transparent);
    color: var(--level-color, var(--brand-600));
    font-weight: 800;
    font-size: var(--text-xs);
    flex-shrink: 0;
  }
  .block-name { color: var(--text-muted); }
  .block-count {
    margin-left: auto;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
  }
  .aside-total {
    margin: var(--space-3) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--text-subtle);
  }
  .aside-tip p {
    margin: 0;
    font-size: var(--text-base);
    color: var(--text-muted);
  }

  @media (max-width: 1100px) {
    .ex-layout { grid-template-columns: minmax(0, 1fr); }
    .ex-aside {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .aside-card { flex: 1 1 16rem; }
  }
</style>
