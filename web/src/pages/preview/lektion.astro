---
/**
 * PROTOTYPE — redesigned lesson (reading) page, rendered with real lesson
 * markdown so callouts, tables and audio widgets can be checked for real.
 */
import { getCollection, render } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';
import '../../styles/prose.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const lessons = await getCollection('lessons');
const entry = lessons.find(e => e.id.startsWith('a1/01-')) ?? lessons[0];
const { Content, headings } = await render(entry);

const [level, slug] = entry.id.split('/');
const title = entry.data.title ?? slug.replace(/^\d+-/, '').replace(/-/g, ' ');
const titleEn = entry.data.titleEn;

// Only h2s make a useful table of contents; h3s would make it noisy.
const toc = headings.filter(h => h.depth === 2);
---

<AppShell
  title={`${title} · ${level.toUpperCase()}`}
  navKey={level}
  variant="app"
  crumbs={[
    { label: level.toUpperCase(), href: `${base}/${level}/` },
    { label: title },
  ]}
>
  <div class="lesson-layout">
    <article class="lesson-main">
      <header class="lesson-head" data-level={level}>
        <div class="lesson-head-top">
          <span class="badge badge-level">{level.toUpperCase()}</span>
          <span class="badge badge-soft">Lektion {slug.split('-')[0]}</span>
        </div>
        <h1>{title}</h1>
        {titleEn && <p class="lesson-title-en">{titleEn}</p>}
        <div class="lesson-actions">
          <a class="btn btn-primary btn-sm" href={`${base}/${level}/${slug}/uebungen/`}>
            Zu den Übungen
            <svg viewBox="0 0 24 24" aria-hidden="true" class="btn-i"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <div class="view-toggle" role="group" aria-label="Lektionsansicht wechseln">
            <button type="button" aria-pressed="true">Ausführlich</button>
            <button type="button" aria-pressed="false">Kurzfassung</button>
          </div>
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>

    {toc.length > 0 && (
      <aside class="lesson-toc">
        <h2 class="toc-title">Auf dieser Seite</h2>
        <nav>
          <ul>
            {toc.map(h => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</AppShell>

<style>
  .lesson-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: var(--space-7);
    align-items: start;
  }
  /* Reading measure stays comfortable even though the shell is full-width. */
  .lesson-main { min-width: 0; max-width: 46rem; }

  .lesson-head {
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--border);
  }
  .lesson-head-top {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .lesson-head h1 {
    margin: 0;
    font-size: var(--text-3xl);
    letter-spacing: -0.025em;
  }
  .lesson-title-en {
    margin: var(--space-1) 0 0;
    color: var(--text-subtle);
    font-size: var(--text-lg);
  }
  .lesson-actions { margin-top: var(--space-4); }

  /* The markdown repeats the title as its own h1 ("A1 · Lektion 1 — …").
     The page header above already carries it, with the English gloss from
     frontmatter, so the duplicate is suppressed. */
  .lesson-main :global(.prose > h1:first-of-type) { display: none; }
  .lesson-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .btn-i {
    width: 1rem; height: 1rem;
    fill: none; stroke: currentColor;
    stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
  }

  .view-toggle {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 2px;
    background: var(--surface-2);
  }
  .view-toggle button {
    border: none;
    background: transparent;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-pill);
    cursor: pointer;
    color: var(--text-muted);
    font: inherit;
    font-weight: 550;
    font-size: var(--text-sm);
    transition: background var(--transition), color var(--transition);
  }
  .view-toggle button[aria-pressed="true"] {
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-xs);
  }
  .view-toggle button:hover:not([aria-pressed="true"]) { color: var(--text); }

  /* ---- table of contents ---- */
  .lesson-toc {
    position: sticky;
    top: calc(var(--topbar-h) + var(--space-6));
    font-size: var(--text-base);
  }
  .toc-title {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .lesson-toc ul { list-style: none; margin: 0; padding: 0; }
  .lesson-toc li { margin: 0; }
  .lesson-toc a {
    display: block;
    padding: 0.35rem var(--space-3);
    border-left: 2px solid var(--border);
    color: var(--text-muted);
    line-height: 1.45;
  }
  .lesson-toc a:hover {
    border-left-color: var(--brand-500);
    color: var(--brand-600);
    background: var(--surface-hover);
    text-decoration: none;
  }

  @media (max-width: 1100px) {
    .lesson-layout { grid-template-columns: minmax(0, 1fr); }
    .lesson-toc { display: none; }
  }
</style>
