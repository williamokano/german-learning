---
/**
 * PROTOTYPE — redesigned home / dashboard.
 * Lives under /preview/ so the new design can be validated before rollout.
 */
import { getCollection } from 'astro:content';
import { coreDedupKeys } from '@core/content/vocab';
import AppShell from '../../layouts/AppShell.astro';
import WortschatzCounter from '../../components/WortschatzCounter.svelte';
import DailyGoalPicker from '../../components/DailyGoalPicker.svelte';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const lessons = await getCollection('lessons');
const vocab = await getCollection('vocab');
const exercises = await getCollection('exercises');
const wortschatzDedupKeys = coreDedupKeys(vocab.flatMap(e => e.data.entries));

const levelIds = [...new Set(lessons.map(e => e.id.split('/')[0]))].sort();
const LEVELS: Record<string, { label: string; blurb: string }> = {
  a1: { label: 'A1', blurb: 'Erste Kontakte, Familie, Alltag' },
  a2: { label: 'A2', blurb: 'Erzählen, vergleichen, begründen' },
  b1: { label: 'B1', blurb: 'Passiv, Konjunktiv, Relativsätze' },
  b2: { label: 'B2', blurb: 'Nominalstil, indirekte Rede, Argumentation' },
  c1: { label: 'C1', blurb: 'Register, Idiomatik, Wissenschaftssprache' },
};

const levelCards = levelIds.map(id => ({
  id,
  label: LEVELS[id]?.label ?? id.toUpperCase(),
  blurb: LEVELS[id]?.blurb ?? '',
  count: lessons.filter(l => l.id.startsWith(`${id}/`)).length,
}));

const extraCount = exercises.filter(e => e.id.startsWith('extra/')).length;
const lessonCount = lessons.length;
const vocabCount = wortschatzDedupKeys.length;

const practice = [
  { href: `${base}/extra/`,  title: 'Zusatzübungen', desc: `${extraCount} eigenständige Grammatik-Sets`, tone: 'extra' },
  { href: `${base}/drills/`, title: 'Drill-Modus',   desc: 'Kurze, gezielte Wiederholung',            tone: 'b1' },
  { href: `${base}/gym/`,    title: 'Grammatik-Gym', desc: 'Ein Thema, viele Sätze',                  tone: 'b2' },
  { href: `${base}/review/`, title: 'Fehlerbuch',    desc: 'Deine Fehler gezielt nacharbeiten',       tone: 'c1' },
];
---

<AppShell title="Übersicht · Deutsch lernen" navKey="" variant="app">
  <div slot="topbar-extra">
    <WortschatzCounter dedupKeys={wortschatzDedupKeys} client:load />
  </div>

  <!-- hero -->
  <section class="hero card">
    <div class="hero-main">
      <p class="eyebrow">Willkommen zurück</p>
      <h1>Weiter geht's mit Deutsch</h1>
      <p class="hero-sub">
        Ein interaktiver Kurs von A1 bis C1 — mit Übungen, die sich selbst
        korrigieren und dir sofort sagen, wo du stehst.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`${base}/today/`}>
          Daily Mix starten
          <svg viewBox="0 0 24 24" aria-hidden="true" class="btn-i"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn-secondary" href={`${base}/path/`}>Lernpfad ansehen</a>
      </div>
    </div>
    <div class="hero-side">
      <DailyGoalPicker client:load />
    </div>
  </section>

  <!-- stats -->
  <section class="stats">
    <div class="stat card">
      <span class="stat-label">Lektionen</span>
      <span class="stat-value">{lessonCount}</span>
      <span class="stat-note">A1 – C1</span>
    </div>
    <div class="stat card">
      <span class="stat-label">Zusatzübungen</span>
      <span class="stat-value">{extraCount}</span>
      <span class="stat-note">eigenständige Sets</span>
    </div>
    <div class="stat card">
      <span class="stat-label">Wortschatz</span>
      <span class="stat-value">{vocabCount}</span>
      <span class="stat-note">Einträge im Kurs</span>
    </div>
    <div class="stat card">
      <span class="stat-label">Niveaus</span>
      <span class="stat-value">{levelIds.length}</span>
      <span class="stat-note">vollständig ausgearbeitet</span>
    </div>
  </section>

  <!-- course levels -->
  <section class="block">
    <div class="block-head">
      <h2>Kurs</h2>
      <a class="block-link" href={`${base}/path/`}>Ganzen Pfad ansehen →</a>
    </div>
    <div class="level-grid">
      {levelCards.map(l => (
        <a class="level-card card" href={`${base}/${l.id}/`} data-level={l.id}>
          <span class="level-chip">{l.label}</span>
          <span class="level-blurb">{l.blurb}</span>
          <span class="level-meta">{l.count} Lektionen</span>
        </a>
      ))}
    </div>
  </section>

  <!-- practice -->
  <section class="block">
    <div class="block-head"><h2>Üben</h2></div>
    <div class="practice-grid">
      {practice.map(p => (
        <a class="practice-card card" href={p.href} data-level={p.tone}>
          <span class="practice-title">{p.title}</span>
          <span class="practice-desc">{p.desc}</span>
        </a>
      ))}
    </div>
  </section>
</AppShell>

<style>
  /* ---- hero ---- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-6);
    margin-bottom: var(--space-5);
    background:
      radial-gradient(120% 140% at 100% 0%, var(--brand-50) 0%, transparent 60%),
      var(--surface);
  }
  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-600);
  }
  .hero h1 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
  }
  .hero-sub {
    margin: 0 0 var(--space-5);
    max-width: 46ch;
    color: var(--text-muted);
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .btn-i {
    width: 1.05rem; height: 1.05rem;
    fill: none; stroke: currentColor;
    stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
  }
  .hero-side { min-width: 0; }

  /* ---- stats ---- */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .stat { padding: var(--space-4) var(--space-5); display: flex; flex-direction: column; }
  .stat-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .stat-value {
    font-size: var(--text-2xl);
    font-weight: 750;
    line-height: 1.2;
    margin-top: var(--space-1);
    font-variant-numeric: tabular-nums;
  }
  .stat-note { font-size: var(--text-sm); color: var(--text-subtle); }

  /* ---- section blocks ---- */
  .block { margin-bottom: var(--space-6); }
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .block-head h2 { margin: 0; font-size: var(--text-xl); letter-spacing: -0.01em; }
  .block-link { font-size: var(--text-base); color: var(--text-muted); font-weight: 500; }
  .block-link:hover { color: var(--brand-600); }

  /* ---- level cards ---- */
  .level-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-4);
  }
  .level-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition),
                border-color var(--transition);
  }
  .level-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--level-color, var(--brand-600));
  }
  .level-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: var(--level-color, var(--brand-400));
    text-decoration: none;
  }
  .level-chip {
    display: inline-grid;
    place-items: center;
    width: 2.6rem; height: 2.6rem;
    border-radius: var(--radius);
    background: var(--level-color, var(--brand-600));
    color: #fff;
    font-weight: 800;
    font-size: var(--text-md);
    letter-spacing: 0.02em;
  }
  .level-blurb { color: var(--text-muted); font-size: var(--text-base); }
  .level-meta {
    margin-top: auto;
    font-size: var(--text-sm);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  /* ---- practice cards ---- */
  .practice-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
  }
  .practice-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    color: inherit;
    border-left: 4px solid var(--level-color, var(--brand-600));
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .practice-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    text-decoration: none;
  }
  .practice-title { font-weight: 650; }
  .practice-desc { font-size: var(--text-base); color: var(--text-muted); }

  @media (max-width: 820px) {
    .hero { grid-template-columns: minmax(0, 1fr); padding: var(--space-5); }
    .hero h1 { font-size: var(--text-2xl); }
  }
</style>
