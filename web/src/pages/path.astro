---
import { getCollection } from 'astro:content';
import { projectLessonEntries, projectVocabSets } from '@core/content/lessons';
import PathMap from '../components/PathMap.svelte';
import { buildPathManifest } from '@core/content/path';
import AppShell from '../layouts/AppShell.astro';

// F9 /path — learning path map (issue #344). Statically renders the 68-node manifest
// at build time. PathMap.svelte adds a client-side overlay (done ✓ / current ◉ /
// locked —) from PathService.

const [lessons, vocab] = await Promise.all([
  getCollection('lessons'),
  getCollection('vocab'),
]);

// Lesson and vocab projection is shared with /today, /plan and /einstufungstest
// (@core/content/lessons) so their links always match the lesson routes.
const lessonsProjected = projectLessonEntries(lessons);
const vocabProjected = projectVocabSets(vocab);

const manifest = buildPathManifest({ lessons: lessonsProjected, vocabSets: vocabProjected });
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<AppShell title="Lernpfad · Deutsch lernen" navKey="path" variant="app">
  <header class="page-head">
    <h1>Lernpfad</h1>
    <p class="lead">
      Alle Lektionen von A1 bis C1 in Reihenfolge — mit deinem Fortschritt.
    </p>
  </header>

  <PathMap manifest={manifest} base={base} client:load />
</AppShell>
