---
import { getCollection } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';

// Standalone grammar-drill sets (THEMEN/, see THEMEN/README.md) — not part of
// the A1–C1 roadmap, so unlike the level index pages this groups by `data.topic`
// (shared across a theme's per-level variants) instead of by lesson number.
const all = await getCollection('exercises');
const themenSets = all.filter(e => e.id.startsWith('themen/'));

const LEVEL_ORDER: Record<string, number> = { A1: 0, A2: 1, B1: 2, B2: 3, C1: 4 };

interface TopicGroup {
  topic: string;
  variants: { id: string; level: string; title: string }[];
}

const groups = new Map<string, TopicGroup>();
for (const entry of themenSets) {
  const topic = entry.data.topic ?? entry.data.title;
  if (!groups.has(topic)) groups.set(topic, { topic, variants: [] });
  // uebungen.astro's own getStaticPaths only reads parts[0]/parts[1] of the
  // entry id (level/lesson) — the glob loader's default id keeps the
  // filename stem as a 3rd segment (".../exercises"), which would otherwise
  // leak into this link and 404.
  const [level, lesson] = entry.id.split('/');
  groups.get(topic)!.variants.push({
    id: `${level}/${lesson}`,
    level: entry.data.level ?? '',
    title: entry.data.title,
  });
}

const topicGroups = [...groups.values()].map(g => ({
  ...g,
  variants: g.variants.sort((a, b) => (LEVEL_ORDER[a.level] ?? 99) - (LEVEL_ORDER[b.level] ?? 99)),
})).sort((a, b) => a.topic.localeCompare(b.topic, 'de'));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<AppShell title="Grammatikthemen — Deutsch lernen" navKey="themen" variant="app" crumbs={[{ label: 'Grammatikthemen' }]}>
  <header class="page-head">
    <span class="badge badge-level" data-level="themen">THEMEN</span>
    <h1>Grammatikthemen</h1>
    <p class="lead">
      Gezielte Übungssets zu einzelnen Grammatikthemen — unabhängig vom
      Lehrplan, ohne zugehörige Lektion. Wähle ein Thema und dein Niveau.
    </p>
    <p class="count">{topicGroups.length} Themen · {themenSets.length} Sets</p>
  </header>

  {topicGroups.length === 0 && <p class="empty">Noch keine Grammatikthemen verfügbar.</p>}

  <ul class="topics">
    {topicGroups.map(g => (
      <li class="topic-card card">
        <p class="topic-title">{g.topic}</p>
        <div class="level-row">
          {g.variants.map(v => (
            <a class="level-badge" data-level={(v.level || '').toLowerCase()} href={`${base}/${v.id}/uebungen/`}>
              {v.level || v.title}
            </a>
          ))}
        </div>
      </li>
    ))}
  </ul>
</AppShell>

<style>
  .page-head { margin-bottom: var(--space-6); max-width: 62ch; }
  .page-head h1 { margin: var(--space-3) 0 var(--space-3); font-size: var(--text-3xl); letter-spacing: -0.02em; }
  .lead { margin: 0; color: var(--text-muted); }
  .count {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .empty { color: var(--text-faint); margin-top: var(--space-6); }

  .topics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: var(--space-4);
  }
  .topic-card {
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .topic-card:hover { border-color: var(--brand-300); box-shadow: var(--shadow-sm); }
  .topic-title { font-weight: 650; margin: 0; }
  .level-row { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: auto; }
  .level-badge {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--level-color, var(--brand-600)) 12%, transparent);
    color: var(--level-color, var(--brand-600));
    border: 1px solid color-mix(in srgb, var(--level-color, var(--brand-600)) 35%, transparent);
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .level-badge:hover {
    background: color-mix(in srgb, var(--level-color, var(--brand-600)) 22%, transparent);
    text-decoration: none;
  }
</style>
