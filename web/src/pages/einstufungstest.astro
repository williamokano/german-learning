---
import { getCollection } from 'astro:content';
import { projectLessonEntries, projectVocabSets } from '@core/content/lessons';
import { buildPathManifest } from '@core/content/path';
import AppShell from '../layouts/AppShell.astro';
import PlacementQuiz from '../components/PlacementQuiz.svelte';

// Placement test (issue #347) — a short staircase quiz that estimates a CEFR
// level and routes the learner onto the matching /path/ node. Builds the same
// 68-node manifest as path.astro (shared projection in @core/content/lessons) so the recommendation lands on a node the path system already knows.

const [lessons, vocab] = await Promise.all([
  getCollection('lessons'),
  getCollection('vocab'),
]);

const lessonsProjected = projectLessonEntries(lessons);
const vocabProjected = projectVocabSets(vocab);

const manifest = buildPathManifest({ lessons: lessonsProjected, vocabSets: vocabProjected });
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<AppShell title="Einstufungstest · Deutsch lernen" navKey="einstufungstest" variant="app">
  <header class="page-head">
    <h1>Einstufungstest</h1>
    <p class="lead">
      Ein paar Fragen, um herauszufinden, wo du am besten einsteigst — statt bei
      A1/01 anzufangen, obwohl du schon mehr kannst.
    </p>
  </header>

  <PlacementQuiz manifest={manifest} base={base} client:load />
</AppShell>

<style>
  .page-head { margin-bottom: var(--space-6); }
  .page-head h1 { margin: 0 0 var(--space-2); font-size: var(--text-2xl); letter-spacing: -0.02em; }
  .lead { margin: 0; color: var(--text-muted); max-width: 60ch; }
</style>
