---
import { getCollection } from 'astro:content';
import DailyMixRunner from '../components/DailyMixRunner.svelte';
import AppShell from '../layouts/AppShell.astro';

// F9 /today — daily mix session (issue #344).
//
// Frontmatter pre-bakes the static content collections. DailyMixRunner.svelte
// mixes them on mount with reactive storage state (srs, fehlerbuch, pillSettings,
// path), walks the session one item at a time, and renders a tally summary on
// completion. Pairs with /path/, the navigation surface that lets the learner see
// where they are in the curriculum.

const [lessons, vocab, exercises] = await Promise.all([
  getCollection('lessons'),
  getCollection('vocab'),
  getCollection('exercises'),
]);

// Project to the minimal structural shapes DailyMixRunner accepts — keeps the
// runner from importing 'astro:content'. `lesson.md` frontmatter has no `lesson`
// field; derive it from `data.number` (padded) for canonical matching with vocab
// sets' `data.lesson`. Same robustness as `path.astro`: fall back to deriving
// `level` and `slug` from the entry id when frontmatter omits them (e.g. A1/01).
const lessonsProjected = lessons
  .map(e => {
    const idSegments = e.id.split('/');
    const levelRaw = e.data.level ?? idSegments[0] ?? '';
    const slugRaw = e.data.slug ?? idSegments[1] ?? '';
    const level = levelRaw.toUpperCase();
    const number = e.data.number;
    if (!level || !slugRaw || number == null) return null;
    return {
      id: e.id,
      data: {
        lesson: `${level}/${String(number).padStart(2, '0')}`,
        slug: slugRaw,
        title: e.data.title ?? '(unbenannt)',
        // path.ts's projectLesson gates `level` against /^[A-C][12]$/ (uppercase only).
        // Always store the uppercased form so lessons with lowercase `level:` frontmatter
        // (or none at all, like A1/01) survive the projection.
        level: level,
        number,
      },
    };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);
const vocabProjected = vocab.map(e => ({
  id: e.id, lesson: e.data.lesson, entries: e.data.entries,
}));
const exerciseEntries = exercises.map(e => ({ id: e.id, data: e.data }));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<AppShell title="Daily Mix · Deutsch lernen" navKey="today" variant="app">
  <header class="page-head">
    <h1>Daily Mix</h1>
    <p class="lead">
      Eine kurze, gemischte Einheit aus neuen Wörtern, Wiederholungen und Drills.
    </p>
  </header>

  <DailyMixRunner
    lessons={lessonsProjected}
    vocabSets={vocabProjected}
    exerciseEntries={exerciseEntries}
    client:load
  />
</AppShell>
