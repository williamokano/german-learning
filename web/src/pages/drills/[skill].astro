---
import { getCollection } from 'astro:content';
import { DrillSkill } from '@core/content/schema';
import { drillBank } from '@core/content/drills';
import DrillRunner from '../../components/DrillRunner.svelte';
import AppShell from '../../layouts/AppShell.astro';

export async function getStaticPaths() {
  return DrillSkill.options.map(skill => ({ params: { skill } }));
}

const { skill } = Astro.params;
const all = await getCollection('exercises');
const items = drillBank(all, skill as (typeof DrillSkill.options)[number]);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<AppShell title={`${skill} — Drill-Modus`} navKey="drills" variant="app" crumbs={[{ label: 'Drill-Modus', href: `${base}/drills/` }, { label: skill }]}>
  <header class="page-head">
    <h1>{skill}</h1>
  </header>

  <DrillRunner items={items} sessionSize={10} client:load />
</AppShell>
