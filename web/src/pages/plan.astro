---
import { getCollection } from 'astro:content';
import { projectLessonEntries, projectVocabSets } from '@core/content/lessons';
import StudyPlanView from '../components/StudyPlanView.svelte';
import { buildPathManifest } from '@core/content/path';
import AppShell from '../layouts/AppShell.astro';

// F14 /plan — exam-date study plan (issue #347). Uses the same path manifest
// projection as path.astro (@core/content/lessons) so the two pages never drift on how a
// lesson entry maps to a PathNode.

const [lessons, vocab] = await Promise.all([
  getCollection('lessons'),
  getCollection('vocab'),
]);

const lessonsProjected = projectLessonEntries(lessons);
const vocabProjected = projectVocabSets(vocab);

const manifest = buildPathManifest({ lessons: lessonsProjected, vocabSets: vocabProjected });
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<AppShell title="Lernplan · Deutsch lernen" navKey="plan" variant="app">
  <header class="page-head">
    <h1>Lernplan</h1>
    <p class="lead">
      Wähle ein Prüfungsziel und ein Datum — wir rechnen dir einen Tagesplan aus.
    </p>
  </header>

  <StudyPlanView manifest={manifest} base={base} client:load />
</AppShell>
