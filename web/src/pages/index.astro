---
const levels = [
  { id: 'a1', label: 'A1 — Anfänger' },
  { id: 'a2', label: 'A2 — Grundlegende Kenntnisse' },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Deutsch lernen</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 4rem auto; padding: 0 1rem; color: #1a1a1a; }
      h1 { font-size: 2rem; }
      ul { list-style: none; padding: 0; margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
      li a { display: block; padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid #e5e7eb; color: #1a1a1a; text-decoration: none; font-weight: 500; }
      li a:hover { border-color: #2563eb; background: #eff6ff; }
    </style>
  </head>
  <body>
    <h1>Deutsch lernen</h1>
    <p>Ein interaktiver Deutschkurs für Selbstlernende.</p>
    <ul>
      {levels.map(l => (
        <li><a href={`${base}/${l.id}/`}>{l.label}</a></li>
      ))}
    </ul>
  </body>
</html>
