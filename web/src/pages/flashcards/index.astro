---
import { getCollection } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';

const all = await getCollection('vocab');
const levelIds = [...new Set(all.map(e => e.id.split('/')[0]))].sort();

const LABELS: Record<string, string> = {
  a1: 'A1 — Anfänger',
  a2: 'A2 — Grundlegende Kenntnisse',
  b1: 'B1 — Fortgeschrittene Grundkenntnisse',
  b2: 'B2 — Selbstständige Sprachverwendung',
  c1: 'C1 — Fachkundige Sprachkenntnisse',
};

const levels = levelIds.map(id => ({ id, label: LABELS[id] ?? id.toUpperCase() }));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<AppShell title="Karteikarten — Deutsch lernen" navKey="flashcards" variant="app" crumbs={[{ label: 'Karteikarten' }]}>
  <header class="page-head">
    <h1>Karteikarten</h1>
    <p class="lead">Wähle ein Level, um Vokabeln zu wiederholen.</p>
  </header>

  <p class="due-row">
    <a class="btn btn-primary" href={`${base}/flashcards/review/`}>
      Fälliges wiederholen →
    </a>
  </p>

  <ul class="link-list">
    {levels.map(l => (
      <li><a href={`${base}/flashcards/${l.id}/`}>{l.label}</a></li>
    ))}
  </ul>
</AppShell>

<style>
  .due-row { margin: 0 0 var(--space-5); }
</style>
