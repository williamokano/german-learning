---
import { getCollection } from 'astro:content';
import FlashcardDeck from '../../components/FlashcardDeck.svelte';
import AppShell from '../../layouts/AppShell.astro';

const all = await getCollection('vocab');
const allEntries = all.flatMap(e => e.data.entries);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<AppShell title="Fälliges wiederholen — Karteikarten" navKey="flashcards" variant="app" crumbs={[{ label: 'Karteikarten', href: `${base}/flashcards/` }, { label: 'Fälliges wiederholen' }]}>
  <header class="page-head">
    <h1>Fälliges wiederholen</h1>
    <p class="lead">
      Eine Auswahl bereits geübter Wörter, priorisiert nach Fälligkeit — quer
      durch den ganzen Kurs.
    </p>
  </header>

  <FlashcardDeck allEntries={allEntries} client:load />
</AppShell>
