---
import { getCollection } from 'astro:content';
import AppShell from '../../../layouts/AppShell.astro';

export async function getStaticPaths() {
  const all = await getCollection('vocab');
  const levels = [...new Set(all.map(e => e.id.split('/')[0]))];
  return levels.map(level => ({
    params: { level },
    props:  { entries: all.filter(e => e.id.startsWith(level + '/')) },
  }));
}

const { level }   = Astro.params;
const { entries } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const sorted = entries
  .map(e => ({ entry: e, slug: e.id.split('/')[1] }))
  .sort((a, b) => a.slug.localeCompare(b.slug));
---

<AppShell title={`${level.toUpperCase()} — Karteikarten`} navKey="flashcards" variant="app" crumbs={[{ label: 'Karteikarten', href: `${base}/flashcards/` }, { label: level.toUpperCase() }]}>
  <header class="page-head">
    <h1>{level.toUpperCase()} — Karteikarten</h1>
    <p class="lead">
      „Nur diese Lektion" übt den neuen Wortschatz. „+ Wiederholung" mischt
      frühere Lektionen mit dazu.
    </p>
  </header>

  <ul class="deck-list">
    {sorted.map(({ slug }) => (
      <li class="deck-row card">
        <a class="deck-name" href={`${base}/flashcards/${level}/${slug}/`}>
          {(([num, ...rest]) => `${num} — ${rest.join('-').replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())}`)(slug.split('-'))}
        </a>
        <span class="deck-actions">
          <a class="btn btn-ghost btn-sm" href={`${base}/flashcards/${level}/${slug}/`}>Nur diese Lektion</a>
          <a class="btn btn-secondary btn-sm" href={`${base}/flashcards/${level}/${slug}/?mode=cumulative`}>+ Wiederholung</a>
        </span>
      </li>
    ))}
  </ul>
</AppShell>

<style>
  .deck-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .deck-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .deck-row:hover { border-color: var(--brand-300); box-shadow: var(--shadow-sm); }
  .deck-name { flex: 1; min-width: 0; color: inherit; font-weight: 600; }
  .deck-name:hover { text-decoration: none; color: var(--brand-600); }
  .deck-actions { display: flex; gap: var(--space-2); flex-shrink: 0; }

  @media (max-width: 700px) {
    .deck-row { flex-wrap: wrap; }
  }
</style>
