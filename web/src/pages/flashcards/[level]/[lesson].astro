---
import { getCollection } from 'astro:content';
import { unlockedVocab } from '@core/content/vocab';
import FlashcardDeck from '../../../components/FlashcardDeck.svelte';
import AppShell from '../../../layouts/AppShell.astro';

export async function getStaticPaths() {
  const all = await getCollection('vocab');
  return all.map(entry => {
    const parts = entry.id.split('/');
    return {
      params: { level: parts[0], lesson: parts[1] },
      props: { entry, all },
    };
  });
}

const { level, lesson } = Astro.params;
const { entry, all } = Astro.props;
const data = entry.data;

const cumulativeEntries = unlockedVocab(all.map(e => e.data), data.lesson);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<AppShell title={`${data.lesson} — Karteikarten`} navKey="flashcards" variant="app" crumbs={[{ label: 'Karteikarten', href: `${base}/flashcards/` }, { label: level.toUpperCase(), href: `${base}/flashcards/${level}/` }, { label: data.lesson }]}>
  <header class="page-head">
    <h1>{data.lesson} — Karteikarten</h1>
    <p class="lead">
      <a href={`${base}/${level}/${lesson}/`}>Zur Lektion →</a>
    </p>
  </header>

  <FlashcardDeck
    lessonEntries={data.entries}
    cumulativeEntries={cumulativeEntries}
    deckLessonId={data.lesson}
    client:load
  />
</AppShell>
