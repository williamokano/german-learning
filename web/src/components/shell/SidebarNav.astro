---
/**
 * SidebarNav — grouped primary navigation.
 *
 * Groups follow a primary / course / practice / utility hierarchy: what you do
 * daily sits at the top, the course itself in the middle, extra practice and
 * vocabulary below. Icons support the labels rather than replacing them —
 * when collapsed, the label is hidden but kept as a tooltip + accessible name.
 *
 * Icons are inlined (stroke-only, 24×24, inherit currentColor) so the page
 * stays self-contained: no icon font, no external requests.
 */
import { getCollection } from 'astro:content';

interface Props { navKey?: string }
const { navKey = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ICONS: Record<string, string> = {
  sparkles: '<path d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z"/><path d="M18 15l.9 2.1L21 18l-2.1.9L18 21l-.9-2.1L15 18l2.1-.9L18 15z"/>',
  map: '<path d="M9 4L3 7v13l6-3 6 3 6-3V4l-6 3-6-3z"/><path d="M9 4v13M15 7v13"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5M3 17l9 5 9-5"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1"/>',
  dumbbell: '<path d="M6.5 6.5v11M17.5 6.5v11M3 9v6M21 9v6M6.5 12h11"/>',
  alert: '<path d="M12 4l9 16H3l9-16z"/><path d="M12 10v4M12 17.5v.5"/>',
  cards: '<rect x="3" y="6" width="13" height="14" rx="2"/><path d="M8 3h9a3 3 0 013 3v10"/>',
  book: '<path d="M4 5a2 2 0 012-2h13v18H6a2 2 0 01-2-2V5z"/><path d="M8 3v18"/>',
  chat: '<path d="M21 12a8 8 0 01-8 8H7l-4 3v-7a8 8 0 018-8h2a8 8 0 018 4z"/>',
  'check-circle': '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/>',
};
const icon = (name: string) => ICONS[name] ?? '';

const lessons = await getCollection('lessons');
const levelIds = [...new Set(lessons.map(e => e.id.split('/')[0]))].sort();

const LEVEL_LABEL: Record<string, string> = {
  a1: 'A1 · Anfänger',
  a2: 'A2 · Grundlagen',
  b1: 'B1 · Mittelstufe',
  b2: 'B2 · Selbstständig',
  c1: 'C1 · Fachkundig',
};

type Item = { key: string; label: string; href: string; icon: string; level?: string };

const groups: { title: string; items: Item[] }[] = [
  {
    title: 'Lernen',
    items: [
      { key: 'today', label: 'Heute',    href: `${base}/today/`, icon: 'sparkles' },
      { key: 'path',  label: 'Lernpfad', href: `${base}/path/`,  icon: 'map' },
      { key: 'plan',  label: 'Lernplan', href: `${base}/plan/`,  icon: 'calendar' },
      { key: 'einstufungstest', label: 'Einstufungstest', href: `${base}/einstufungstest/`, icon: 'check-circle' },
    ],
  },
  {
    title: 'Kurs',
    items: levelIds.map(id => ({
      key: id,
      label: LEVEL_LABEL[id] ?? id.toUpperCase(),
      href: `${base}/${id}/`,
      icon: 'book',
      level: id,
    })),
  },
  {
    title: 'Üben',
    items: [
      { key: 'themen',      label: 'Grammatikthemen',   href: `${base}/themen/`,      icon: 'layers', level: 'themen' },
      { key: 'situationen', label: 'Alltagssituationen', href: `${base}/situationen/`, icon: 'chat',   level: 'situationen' },
      { key: 'drills', label: 'Drill-Modus',   href: `${base}/drills/`, icon: 'target' },
      { key: 'gym',    label: 'Grammatik-Gym', href: `${base}/gym/`,    icon: 'dumbbell' },
      { key: 'review', label: 'Fehlerbuch',    href: `${base}/review/`, icon: 'alert' },
    ],
  },
  {
    title: 'Wortschatz',
    items: [
      { key: 'flashcards', label: 'Karteikarten', href: `${base}/flashcards/`, icon: 'cards' },
    ],
  },
];
---

<nav class="sidenav" aria-label="Hauptnavigation">
  {groups.map(group => (
    <div class="sidenav-group">
      <h2 class="sidenav-title">{group.title}</h2>
      <ul>
        {group.items.map(item => (
          <li>
            <a
              href={item.href}
              class="sidenav-link"
              data-level={item.level}
              aria-current={navKey === item.key ? 'page' : undefined}
              title={item.label}
            >
              <span class="sidenav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={icon(item.icon)} />
              </span>
              <span class="sidenav-label">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

<style>
  .sidenav { padding: var(--space-4) var(--space-3) var(--space-5); }

  .sidenav-group + .sidenav-group { margin-top: var(--space-5); }

  .sidenav-title {
    margin: 0 0 var(--space-2);
    padding: 0 var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .sidenav ul { list-style: none; margin: 0; padding: 0; }
  .sidenav li + li { margin-top: 1px; }

  .sidenav-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.5rem var(--space-3);
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.4;
    position: relative;
    transition: background var(--transition), color var(--transition);
  }
  .sidenav-link:hover {
    background: var(--surface-hover);
    color: var(--text);
    text-decoration: none;
  }
  .sidenav-link[aria-current="page"] {
    background: var(--brand-50);
    color: var(--brand-700);
    font-weight: 650;
  }
  /* A left rail marks the active item — tinted per level where one applies. */
  .sidenav-link[aria-current="page"]::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    translate: 0 -50%;
    width: 3px;
    height: 1.15rem;
    border-radius: 0 3px 3px 0;
    background: var(--level-color, var(--brand-600));
  }

  .sidenav-icon {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--level-color, currentColor);
  }
  .sidenav-icon svg {
    width: 1.15rem; height: 1.15rem;
    fill: none; stroke: currentColor;
    stroke-width: 1.85; stroke-linecap: round; stroke-linejoin: round;
  }

  .sidenav-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Collapsed rail: icons only. */
  :global(:root[data-sidebar="collapsed"]) .sidenav { padding-inline: var(--space-2); }
  :global(:root[data-sidebar="collapsed"]) .sidenav-label { display: none; }
  :global(:root[data-sidebar="collapsed"]) .sidenav-link { justify-content: center; padding-inline: 0; }
  :global(:root[data-sidebar="collapsed"]) .sidenav-title {
    text-align: center;
    padding: 0;
    font-size: 0.6rem;
    overflow: hidden;
  }

  /* The drawer is always full-width, even if the desktop rail is collapsed. */
  @media (max-width: 900px) {
    :global(:root[data-sidebar="collapsed"]) .sidenav { padding-inline: var(--space-3); }
    :global(:root[data-sidebar="collapsed"]) .sidenav-label { display: block; }
    :global(:root[data-sidebar="collapsed"]) .sidenav-link {
      justify-content: flex-start;
      padding-inline: var(--space-3);
    }
    :global(:root[data-sidebar="collapsed"]) .sidenav-title {
      text-align: left;
      padding-inline: var(--space-3);
      font-size: var(--text-xs);
    }
  }
</style>
